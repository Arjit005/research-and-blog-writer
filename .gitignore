# ==============================================================
# .gitignore — Research & Blog Writer
# ==============================================================

# --- Environment & Secrets ---
.env
.env.local

# --- Python ---
__pycache__/
*.py[cod]               # .pyc, .pyo, .pyd files
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/

# --- IDE & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS files ---
.DS_Store               # macOS
Thumbs.db               # Windows
Desktop.ini

# --- crewAI output ---
report.md
crew.log                # Execution logs

# --- Database ---
*.db
*.db-wal
*.db-shm


# --- Claude Code ---
.claude/

# --- Misc ---
*.bak

# --- Local audit/security scan cache ---
.pip-audit-cache/

# --- Test/coverage artifacts ---
.coverage
.coverage.*
htmlcov/
pytest-of-Dell/

# --- Local CrewAI storage (if created in workspace) ---
crewai/
.crewai-test-storage/

# --- Frontend (Next.js / Node) ---
frontend/node_modules/
frontend/.next/
frontend/out/
.pytest_cache/

*.tmp

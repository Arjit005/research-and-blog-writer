{
  // ==============================================================
  // Free AI Models Registry
  // ==============================================================
  // Declarative catalog of free-tier AI models and the API keys
  // (environment variables) that grant access to them.
  //
  // Source of truth for runtime behavior remains llm_fallback.py.
  // Keep IDs/prefixes here consistent when changing runtime chains.
  //
  // Model availability, quotas, and exact IDs change upstream.
  // Entries marked verification_needed should be confirmed against
  // each provider's current catalog before runtime enablement.
  //
  // DO NOT store real secrets in this file. Use .env / .env.example.
  // ==============================================================

  "version": 2,
  "updated": "2026-11-06",

  "providers": [
    {
      "id": "groq",
      "name": "Groq",
      "website": "https://console.groq.com/keys",
      "api_style": "openai_compatible",
      "base_url": "https://api.groq.com/openai/v1",
      "model_id_prefix": "groq/",
      "api_keys": [
        {
          "env": "GROQ_API_KEY",
          "required": false,
          "description": "Groq API key. Free tier available without credit card; rate limits are organization-level."
        }
      ],
      "priority": 1,
      "notes": "Very fast inference. Suggested as primary in agent fallback profiles when configured and model IDs are verified.",
      "models": [
        {
          "id": "groq/openai/gpt-oss-120b",
          "label": "GPT-OSS 120B (Groq)",

# ==============================================================
# Environment Variables for Research & Blog Writer
# ==============================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# NEVER commit the .env file — it contains secrets!
# ==============================================================

# --- Google Gemini API Key (Required) ---
# Powers all 4 agents and the Streamlit Editorial Copilot
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Serper.dev API Key (Required) ---
# Powers web search for Researcher and Quality Reviewer agents
# Get yours at: https://serper.dev/ (free tier: 2500 searches)
SERPER_API_KEY=your_serper_api_key_here

# --- Optional: Alternative LLM Keys (via LiteLLM) ---
# Only needed if you switch any agent's LLM to another provider
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

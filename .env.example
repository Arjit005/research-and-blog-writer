# ==============================================================
# Environment Variables for Research & Blog Writer
# ==============================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# NEVER commit the .env file — it contains secrets!
# ==============================================================

# --- OpenRouter API Key (Recommended) ---
# Automatically enables multi-model failover across top free models:
# 1. nvidia/nemotron-3.5-lightning:free
# 2. nvidia/nemotron-3-ultra-550b-a55b:free
# 3. nvidia/nemotron-3.5-super-vl:free
# 4. dots-studio/dots-3-note-preview:free
# 5. cohere/north-mini-code:free
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Google Gemini API Key (Optional / Direct) ---
# Direct access to Google Gemini models
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Search Configuration ---
# DuckDuckGo is used by default with ZERO setup (no API key needed).
# If you wish to use Serper.dev as an optional fallback or alternative:
# SERPER_API_KEY=your_serper_api_key_here

# --- TiDB Cloud Database (Optional / MySQL-Compatible) ---
# Connect to TiDB Cloud Serverless for distributed persistent storage.
# If omitted, the system seamlessly uses local SQLite (research_studio.db).
# Example for Tokyo (ap-northeast-1) on AWS:
TIDB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_prefix.root
TIDB_PASSWORD=your_tidb_password_here
TIDB_DATABASE=research_studio

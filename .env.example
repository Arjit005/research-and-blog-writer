# ==============================================================
# Environment Variables for Research & Blog Writer
# ==============================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# NEVER commit the .env file — it contains secrets!
# ==============================================================

# --- OpenRouter API Key (Recommended) ---
# Automatically enables multi-model failover across top free models:
# 1. nvidia/nemotron-3.5-lightning:free
# 2. nvidia/nemotron-3-ultra-550b-a55b:free
# 3. nvidia/nemotron-3.5-super-vl:free
# 4. dots-studio/dots-3-note-preview:free
# 5. cohere/north-mini-code:free
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Google Gemini API Key (Optional / Direct) ---
# Direct access to Google Gemini models
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- BeatAPI Key (Free models: GLM, DeepSeek, Hunyuan) ---
# Direct OpenAI-compatible endpoint at https://api.beatapi.io/v1
# Free models: glm-5.3-flash-free, deepseek-v4.1-flash-free, hy4-free
# Get yours at: https://beatapi.io
BEATAPI_KEY=your_beatapi_key_here

# --- Search Configuration ---
# DuckDuckGo is used by default with ZERO setup (no API key needed).
# If you wish to use Serper.dev as an optional fallback or alternative:
# SERPER_API_KEY=your_serper_api_key_here

# --- TiDB Cloud Database (Optional / MySQL-Compatible) ---
# Connect to TiDB Cloud Serverless for distributed persistent storage.
# If omitted, the system seamlessly uses local SQLite (research_studio.db).
# Example for Tokyo (ap-northeast-1) on AWS:
TIDB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_prefix.root
TIDB_PASSWORD=your_tidb_password_here
TIDB_DATABASE=test

# --- Authentication Secrets ---
# REQUIRED outside of AUTH_DEV_MODE=true. There are NO derived Render fallbacks:
# startup fails fast if either secret is missing in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OTP_PEPPER=your_32_byte_hex_pepper_secret_here
SESSION_SECRET=your_32_byte_hex_session_secret_here

# --- SMTP Email Delivery (Gmail, Brevo, Resend, SendGrid) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM=AI Research Studio <your_email@gmail.com>
SMTP_USE_TLS=true

# --- Security & Rate Limiting Thresholds ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_EMAIL_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20
SESSION_TTL_HOURS=168
ALLOWED_EMAIL_DOMAINS=

# --- Local Development Mode ---
# When true, skips external SMTP and outputs verification codes directly in UI.
# In dev mode only, fixed PUBLIC test secrets are used if OTP_PEPPER/SESSION_SECRET
# are left blank, and API responses may include the raw session token/dev code.
# AUTH_DEV_MODE is refused when a real production DB is configured (TIDB_HOST AND
# TIDB_USER both set) unless ALLOW_DEV_MODE_WITH_PROD_DB=true is explicitly set.
AUTH_DEV_MODE=false

# --- Deployment / Cookie Security ---
# Session cookies are marked Secure and use the __Host- prefix only when one of
# these explicit signals is set: ENVIRONMENT=production, RENDER/RENDER_SERVICE_ID,
# or AUTH_COOKIE_SECURE=true. Set ENVIRONMENT=production in Docker/Render/Fly.
ENVIRONMENT=development
AUTH_COOKIE_SECURE=false
# Allowed Origin/Host for the frontend when it is served from a different origin.
# CSRF checks require an exact scheme+host+port match (no prefix matching).
# FRONTEND_ORIGIN=https://your-frontend.example.com

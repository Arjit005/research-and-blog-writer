# ==============================================================
# Environment Variables for Research & Blog Writer
# ==============================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# NEVER commit the .env file — it contains secrets!
# ==============================================================

# --- Groq API Key (for Llama 4 models) ---
# Used by: Research agent, Content Analyst agent
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Google Gemini API Key (for Gemini Flash models) ---
# Used by: Report Writer agent, Quality Reviewer agent
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Serper.dev API Key (for web search tool) ---
# Used by: SearchTool (web search capabilities)
# Get yours at: https://serper.dev/ (free tier: 2500 searches)
SERPER_API_KEY=your_serper_api_key_here

# --- Optional: OpenAI API Key ---
# Only needed if you switch any agent's LLM to an OpenAI model
# OPENAI_API_KEY=your_openai_api_key_here
